# Copy to .env. Holds only what is the same in every environment, and names the environment.
# Everything that differs per environment (database, credentials) lives in .env.{APP_ENV}:
# copy .env.environment.example to .env.local, .env.staging and .env.production.
# None of these files is ever committed.

APP_NAME='2morrow 2day'

# local | staging | production. Decides which .env.{APP_ENV} file is laid over this one.
APP_ENV=local

APP_TIMEZONE=Africa/Accra
