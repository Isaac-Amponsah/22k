# GitHub Actions — Production Environment Secrets
#
# Add these in: Repository → Settings → Environments → "production" → Add secret.
# Recommend enabling required reviewers on the "production" environment.
# Workflow: .github/workflows/deploy-production.yml
# VPS path: /home/movgist/htdocs/movgist.com
#
# Do NOT commit real values to this file. This is a reference template.

# ─── SSH access to VPS ───────────────────────────────────────────────────────
VPS_HOST=                    # Production VPS IP or domain
VPS_USER=                    # SSH username, e.g. movgist
VPS_PASSWORD=                # SSH password (rotate after team changes)
VPS_PORT=22                  # SSH port (optional; defaults to 22)

# ─── Optional: notifications on deploy success/failure ───────────────────────
# SLACK_WEBHOOK_URL=
# DISCORD_WEBHOOK_URL=

# ─── Notes ───────────────────────────────────────────────────────────────────
# Database migrations are intentionally NOT run from CI in production.
# Run manually on the VPS after verifying on staging:
#   ssh movgist@<host>
#   cd /home/movgist/htdocs/movgist.com/current
#   php database/migrate.php

# gh secret set -f secret.env.production --env production


# Pushing to production
gh pr create --base main --head staging --title "promote staging to production"
gh pr merge --merge