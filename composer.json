{
    "name": "aidingminds/payroll",
    "description": "Payroll for an accountant's clients: one sign-in, each client's books kept apart.",
    "type": "project",
    "require": {
        "php": ">=8.3",
        "ext-pdo_pgsql": "*",
        "ext-zip": "*",
        "ext-gd": "*",
        "ext-fileinfo": "*",
        "ext-mbstring": "*",
        "phpoffice/phpspreadsheet": "^5.7",
        "phpmailer/phpmailer": "^7.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^11"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "migrate": "php database/migrate.php"
    }
}
